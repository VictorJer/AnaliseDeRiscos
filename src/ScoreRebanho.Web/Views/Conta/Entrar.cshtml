@model ScoreRebanho.Web.ViewModels.Conta.EntrarViewModel
@{
    ViewData["Title"] = "Entrar";
}
<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-2">Entre na sua conta</h1>
                <p class="text-secondary">Acesse o Score do Rebanho com seu e-mail e senha.</p>
                <form asp-controller="Conta" asp-action="Entrar" method="post">
                    <input asp-for="ReturnUrl" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" type="email" autocomplete="username" maxlength="256" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Senha" class="form-label"></label>
                        <input asp-for="Senha" class="form-control" autocomplete="current-password" maxlength="128" value="" />
                        <span asp-validation-for="Senha" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-4">
                        <input asp-for="ManterConectado" class="form-check-input" />
                        <label asp-for="ManterConectado" class="form-check-label"></label>
                    </div>
                    <button type="submit" class="btn btn-success w-100">Entrar</button>
                </form>
                <p class="mt-3 mb-0 text-center">Ainda não tem conta? <a asp-action="Cadastrar">Cadastrar</a></p>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
