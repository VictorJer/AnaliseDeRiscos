@model RebanhoFormularioViewModel
@{
    ViewData["Title"] = "Editar rebanho";
    ViewData["AcaoSalvar"] = "Editar";
    ViewData["AcaoConferir"] = "ConferirEdicao";
}
<div class="cabecalho-pagina p-4 p-lg-5 mb-4">
    <p class="rotulo-secao text-body-secondary mb-2">Atualize seu planejamento</p>
    <h1>Editar rebanho</h1>
    <p class="text-body-secondary mb-0">Salvar recalcula a análise com as premissas vigentes e preserva os scores anteriores.</p>
</div>
<partial name="_EtapasSimulacao" />
@if (Context.Response.StatusCode == 409)
{
    <div class="alert alert-warning" role="alert">
        Os dados foram alterados em outra sessão. Seu preenchimento foi mantido.
        <a asp-action="Editar" asp-route-id="@Model.Id" class="alert-link">Recarregar dados atuais</a>
    </div>
}
<partial name="_Formulario" model="Model" />

@section Scripts {
    <script src="~/lib/leaflet/leaflet.js" asp-append-version="true"></script>
    <script src="~/js/localizacao.js" asp-append-version="true"></script>
}
@section Styles {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/localizacao.css" asp-append-version="true" />
}
