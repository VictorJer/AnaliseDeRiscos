@model ScoreRebanho.Web.ViewModels.Acompanhamento.CondicaoTempoViewModel
<svg class="icone-tempo flex-shrink-0" width="68" height="68" viewBox="0 0 64 64" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @if (Model.Icone is "sol" or "sol-nuvem")
    {
        <g class="tempo-sol">
            <circle cx="@(Model.Icone == "sol" ? 32 : 23)" cy="@(Model.Icone == "sol" ? 31 : 23)" r="12" />
            @if (Model.Icone == "sol")
            {
                <path d="M32 8v5M32 49v5M9 31h5M50 31h5M16 15l4 4M44 43l4 4M16 47l4-4M44 19l4-4" />
            }
            else
            {
                <path d="M23 3v4M3 23h4M9 9l3 3M36 9l-3 3M9 37l3-3" />
            }
        </g>
    }
    @if (Model.Icone is "nuvem" or "sol-nuvem" or "chuva" or "tempestade" or "neve" or "neblina")
    {
        <path class="tempo-nuvem" d="M17 42a10 10 0 1 1 1-20 15 15 0 0 1 29 3 9 9 0 1 1 1 17Z" />
    }
    @if (Model.Icone == "chuva")
    {
        <path class="tempo-agua" d="m21 49-3 6m14-6-3 6m14-6-3 6" />
    }
    @if (Model.Icone == "tempestade")
    {
        <path class="tempo-raio" d="m33 36-9 15h9l-4 11 15-18H33l5-8Z" />
        <path class="tempo-agua" d="m17 48-3 6m37-6-3 6" />
    }
    @if (Model.Icone == "neve")
    {
        <path class="tempo-agua" d="M21 48v9m-4-7 8 5m0-5-8 5m25-7v9m-4-7 8 5m0-5-8 5" />
    }
    @if (Model.Icone == "neblina")
    {
        <path class="tempo-neblina" d="M11 48h42M16 55h32" />
    }
    @if (Model.Icone == "indisponivel")
    {
        <g class="tempo-neblina"><circle cx="32" cy="32" r="22" /><path d="M26 25a6 6 0 1 1 9 5c-3 2-3 3-3 6m0 7h.01" /></g>
    }
</svg>
