@model ScoreRebanho.Web.ViewModels.Acompanhamento.FalhaPrevisaoViewModel
@{ ViewData["Title"] = "Previsão do tempo"; }
<h1 class="my-4">Previsão do tempo</h1>
<div class="alert alert-warning" role="alert">@Model.Mensagem</div>
<div class="d-flex flex-wrap gap-3">
    <a asp-action="Index" class="btn btn-outline-success">Voltar ao acompanhamento</a>
    @if (Model.SemLocalizacao)
    {
        <a asp-controller="Rebanhos" asp-action="Editar" asp-route-id="@Model.Id" asp-fragment="localizacao" class="btn btn-success">Adicionar localização para ver a previsão</a>
    }
    else
    {
        <a asp-action="Detalhes" asp-route-id="@Model.Id" class="btn btn-success">Tentar novamente</a>
    }
</div>
