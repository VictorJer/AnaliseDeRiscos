@model List<AlertaViewModel>
@if (Model.Count > 0)
{
    <section class="my-4" aria-labelledby="alertas-titulo">
        <h2 id="alertas-titulo" class="h4">Pontos de atenção e recomendações</h2>
        @foreach (var alerta in Model)
        {
            <div class="alert alert-warning"><p class="fw-semibold mb-1">@alerta.Mensagem</p><p class="mb-0">@alerta.Recomendacao</p></div>
        }
    </section>
}
