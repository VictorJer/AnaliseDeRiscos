@model ErrorViewModel
@{ ViewData["Title"] = "Não foi possível concluir"; }
<h1>Não foi possível concluir a operação</h1>
<p>Ocorreu um erro inesperado. Tente novamente em alguns instantes.</p>
@if (Model.ShowRequestId)
{
    <p class="small text-body-secondary">Código para suporte: <code>@Model.RequestId</code></p>
}
<a asp-controller="Home" asp-action="Index" class="btn btn-outline-success">Voltar ao início</a>
