@model SimulacaoViewModel
    <fieldset class="card mb-4">
        <legend class="card-header h5 mb-0">1. Terreno e pastagem</legend>
        <div class="card-body row g-3">
            <div class="col-md-4">
                <label asp-for="Posse" class="form-label"></label>
                <select asp-for="Posse" class="form-select"><option value="">Selecione</option><option value="1">Próprio</option><option value="2">Arrendado</option></select>
                <span asp-validation-for="Posse" class="text-danger-emphasis"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Pastagem" class="form-label"></label>
                <select asp-for="Pastagem" class="form-select"><option value="">Selecione</option><option value="1">Verão</option><option value="2">Inverno</option></select>
                <span asp-validation-for="Pastagem" class="text-danger-emphasis"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="AreaHectares" class="form-label"></label>
                <input asp-for="AreaHectares" class="form-control" type="text" inputmode="decimal" />
                <span asp-validation-for="AreaHectares" class="text-danger-emphasis"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ArrendamentoMensalReais" class="form-label"></label>
                <input asp-for="ArrendamentoMensalReais" class="form-control" type="text" inputmode="decimal" />
                <span asp-validation-for="ArrendamentoMensalReais" class="text-danger-emphasis"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="NumeroPiquetes" class="form-label"></label>
                <input asp-for="NumeroPiquetes" class="form-control" type="number" inputmode="numeric" />
                <span asp-validation-for="NumeroPiquetes" class="text-danger-emphasis"></span>
            </div>
            <div class="col-md-6">
                <div class="form-check">
                    <input asp-for="PastoPronto" class="form-check-input" />
                    <label asp-for="PastoPronto" class="form-check-label"></label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-check">
                    <input asp-for="RotacaoAtiva" class="form-check-input" />
                    <label asp-for="RotacaoAtiva" class="form-check-label"></label>
                </div>
            </div>
            <p class="form-text mb-0">Use vírgula nos valores decimais. Informe arrendamento apenas para terreno arrendado e piquetes quando houver rotação.</p>
        </div>
    </fieldset>
    <fieldset class="card mb-4">
        <legend class="card-header h5 mb-0">2. Lote</legend>
        <div class="card-body row g-3">
            <div class="col-md-4">
                <label asp-for="QuantidadeAnimais" class="form-label"></label>
                <input asp-for="QuantidadeAnimais" class="form-control" type="number" inputmode="numeric" />
                <span asp-validation-for="QuantidadeAnimais" class="text-danger-emphasis"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="PesoCompraKg" class="form-label"></label>
                <input asp-for="PesoCompraKg" class="form-control" type="text" inputmode="decimal" />
                <span asp-validation-for="PesoCompraKg" class="text-danger-emphasis"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="PrecoCompraPorKgReais" class="form-label"></label>
                <input asp-for="PrecoCompraPorKgReais" class="form-control" type="text" inputmode="decimal" />
                <span asp-validation-for="PrecoCompraPorKgReais" class="text-danger-emphasis"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="DiasPastagem" class="form-label"></label>
                <input asp-for="DiasPastagem" class="form-control" type="number" inputmode="numeric" />
                <span asp-validation-for="DiasPastagem" class="text-danger-emphasis"></span>
            </div>
            <div class="col-md-6">
                <div class="form-check">
                    <input asp-for="RacaPuraCorte" class="form-check-input" />
                    <label asp-for="RacaPuraCorte" class="form-check-label"></label>
                </div>
            </div>
        </div>
    </fieldset>
    <fieldset class="card mb-4">
        <legend class="card-header h5 mb-0">3. Saúde e manejo</legend>
        <div class="card-body row g-3">
            <div class="col-md-6">
                <div class="form-check">
                    <input asp-for="VacinaCarbunculo" class="form-check-input" />
                    <label asp-for="VacinaCarbunculo" class="form-check-label"></label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-check">
                    <input asp-for="ControleCarrapato" class="form-check-input" />
                    <label asp-for="ControleCarrapato" class="form-check-label"></label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-check">
                    <input asp-for="Vermifugo" class="form-check-input" />
                    <label asp-for="Vermifugo" class="form-check-label"></label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-check">
                    <input asp-for="ModificadorOrganico" class="form-check-input" />
                    <label asp-for="ModificadorOrganico" class="form-check-label"></label>
                </div>
            </div>
        </div>
    </fieldset>
