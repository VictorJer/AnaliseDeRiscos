@model ListaScoresAdministrativosViewModel
@{ ViewData["Title"] = "Administração de scores"; }
<div class="cabecalho-pagina p-4 p-lg-5 mb-4"><p class="rotulo-secao text-body-secondary mb-2">Consulta administrativa</p><h1>Administração de scores</h1>
<p class="text-body-secondary mb-0">Históricos de todos os usuários, do mais recente para o mais antigo. Consulta sem edição ou exclusão.</p></div>
@if (Model.Itens.Count == 0)
{
    <p class="alert alert-info">Nenhum score nesta página.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead><tr><th>Data (UTC)</th><th>Autor</th><th>Rebanho / propriedade</th><th>Score</th><th>Premissas</th><th>Ação</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Itens)
            {
                <tr data-score-id="@item.Id">
                    <td>@F.Data(item.CalculadoEmUtc)</td><td>@(item.AutorEmail ?? item.AutorId)</td>
                    <td>@(item.NomeRebanho ?? "Simulação avulsa")<br /><span class="small text-body-secondary">@item.Propriedade</span></td>
                    <td>@item.Score / 100<br /><span class="small">@F.Risco(item.Classificacao)</span></td>
                    <td>@item.VersaoPremissas</td>
                    <td><a asp-action="Detalhes" asp-route-id="@item.Id" class="btn btn-outline-success btn-sm">Abrir relatório</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
<nav aria-label="Páginas de scores" class="d-flex flex-wrap gap-3 align-items-center my-4">
    @if (Model.Pagina > 1)
    {
        <a asp-action="Index" asp-route-pagina="@(Model.Pagina - 1)" class="btn btn-outline-secondary">Anterior</a>
    }
    <span>Página @Model.Pagina de @Model.Paginas · @Model.Total registros</span>
    @if (Model.Pagina < Model.Paginas)
    {
        <a asp-action="Index" asp-route-pagina="@(Model.Pagina + 1)" class="btn btn-outline-secondary">Próxima</a>
    }
</nav>
