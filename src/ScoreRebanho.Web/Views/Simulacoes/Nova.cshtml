@model SimulacaoFormularioViewModel
@{
    ViewData["Title"] = "Simulação avulsa";
}
<div class="cabecalho-pagina p-4 p-lg-5 mb-4">
    <p class="rotulo-secao text-body-secondary mb-2">Explore uma nova operação</p>
    <h1>Simulação avulsa</h1>
    <p class="text-body-secondary mb-0">Informe os dados para estimar a operação sem cadastrar um rebanho. Cada cálculo válido gera uma nova análise histórica.</p>
</div>
<partial name="_EtapasSimulacao" />
<form asp-controller="Simulacoes" asp-action="Gerar" method="post" class="pb-4">
    <div asp-validation-summary="All" class="text-danger-emphasis" role="alert"></div>
    @Html.EditorFor(m => m.Entradas)
    <partial name="_ConferenciaOcupacao" model="Model.Conferencia" />
    <div class="d-flex flex-wrap gap-3">
        <button type="submit" asp-action="Conferir" class="btn btn-outline-success">Conferir ocupação</button>
        <button type="submit" class="btn btn-success">Gerar score</button>
        <a asp-action="Nova" class="btn btn-outline-secondary">Novo score</a>
        <a asp-controller="Rebanhos" asp-action="Index" class="btn btn-outline-secondary">Meus rebanhos</a>
    </div>
    <p class="small text-body-secondary mt-3">Os resultados são estimativas. Não garantem lucro, segurança da operação ou aprovação de crédito.</p>
</form>
